#!/usr/bin/bash
# Framebuffer splash launcher for the boot and shutdown screens.
set -u

# Hide the VT cursor and clear buffered console text (e.g. a wall broadcast):
# a later fbcon repaint must draw blank, not text over the sail.
printf '\033[?25l\033[H\033[2J\033[3J' > /dev/tty0 2>/dev/null || true

eval "$(/usr/libexec/armada/device-env)" 2>/dev/null || true

# 50% from first light; systemd-backlight is masked (its restored value is
# often near-dark) and Steam applies the user's level at session start.
bl="${ARMADA_PRIMARY_BACKLIGHT:+/sys/class/backlight/${ARMADA_PRIMARY_BACKLIGHT}}"
if [[ -z "$bl" ]]; then
    bls=(/sys/class/backlight/*)
    (( ${#bls[@]} == 1 )) && [[ -d "${bls[0]}" ]] && bl="${bls[0]}"
fi
if [[ -n "$bl" && -r "$bl/max_brightness" && -w "$bl/brightness" ]]; then
    printf '%s' "$(( $(cat "$bl/max_brightness") / 2 ))" > "$bl/brightness" 2>/dev/null || true
fi

case "${ARMADA_PANEL_ORIENTATION:-normal}" in
    right) rot=90 ;;
    left) rot=270 ;;
    upsidedown) rot=180 ;;
    *) rot=0 ;;
esac

# fb0 exists only once the DPU binds (~3s into boot).
for ((i = 0; i < 100; i++)); do
    [[ "$(cat /sys/class/graphics/fb0/name 2>/dev/null)" == msmdrmfb ]] && break
    sleep 0.1
done

exec /usr/libexec/armada/armada-splash --backend fbdev --rotate "$rot" --keep-vt \
    --image /usr/share/armada/splash/splash.asp \
    --status /run/armada/splash/status \
    --font /usr/share/armada/splash/font.ttf
